# Environment — never commit real values
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/
# Anchored to where vitest actually writes coverage output. An unanchored
# `coverage/` matches a directory of that name at ANY depth, and it silently
# swallowed `apps/web/src/app/analyze/coverage/` — the whole route — for a
# whole milestone. Every local command passed, because the file was on disk;
# only CI, building from a clean checkout, saw the 404.
/apps/web/coverage/
/services/api/coverage/
# Copied from node_modules by apps/web/scripts/copy-maplibre-worker.mjs on
# every `npm run dev` / `npm run build`, so it always matches the installed
# MapLibre. Committed, it would drift from it.
/apps/web/public/maplibre/
playwright-report/
test-results/
.playwright/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local data — large geo extracts and model caches are downloaded, never committed
data/cache/
data/nyc/
.fastembed_cache/

# Build/scratch
dist/
*.log

# Agent scratch. Worktrees are checkouts of this same repo — committing one
# would nest the whole tree inside itself. `.superpowers/` holds per-plan
# execution ledgers and review packages, which are working notes, not history.
.claude/worktrees/
.superpowers/

# Playwright signed-in state (M5b). A real session token — never committed.
apps/web/e2e-seeded/.auth/
