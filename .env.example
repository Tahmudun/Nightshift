# Nightshift environment — copy to .env via `make setup`.
#
# Every value here is a local development default. There are no secrets in this
# file and there must never be: the entire M0-M4 stack is zero-key by design
# (see docs/architecture/costs.md and docs/spec/AMENDMENTS.md A4/A9).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NIGHTSHIFT_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Postgres (docker compose service `postgres`)
# ---------------------------------------------------------------------------
POSTGRES_USER=nightshift
POSTGRES_PASSWORD=nightshift_dev_only
POSTGRES_DB=nightshift
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Async driver for the app, sync driver for Alembic. Derived from the values
# above when unset, so you normally do not need to touch these.
# DATABASE_URL=postgresql+asyncpg://nightshift:nightshift_dev_only@localhost:5433/nightshift

# ---------------------------------------------------------------------------
# Redis (docker compose service `redis`) — ARQ queue + geocode cache
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Single-user mode (AMENDMENTS A3 — no auth until M5).
# Every user-owned table still carries a real user_id FK; this is the seeded id
# that stands in for a session until an auth adapter exists.
# ---------------------------------------------------------------------------
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=dev@nightshift.local

# ---------------------------------------------------------------------------
# Ingestion. OUTBOUND_HTTP_ENABLED=false makes `make demo` fully offline:
# adapters refuse to open sockets and ingestion runs from committed fixtures.
# ---------------------------------------------------------------------------
OUTBOUND_HTTP_ENABLED=false
# Quoted because this value contains parentheses. The Makefile sources this file
# with bash `set -a`, so an unquoted `(` is a shell syntax error, not a string.
# All three consumers — bash, `docker compose --env-file`, and python-dotenv via
# pydantic-settings — strip surrounding double quotes, so quoting is safe here
# and required. See tests/test_env_example.py.
HTTP_USER_AGENT="Nightshift/0.1 (+https://github.com/Tahmudun/Nightshift)"
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
SOURCE_REQUESTS_PER_SECOND=2

# ---------------------------------------------------------------------------
# Polling (M1d, ADR 0007). Every value here is a plain integer, so none of the
# three parsers needs it quoted.
# ---------------------------------------------------------------------------
# Hot = the board produced an NYC posting recently. Warm = everything else.
# A weekly tier was considered and rejected: a company's first NYC role could
# sit unseen for six days, which breaks the one promise the product makes.
POLL_HOT_INTERVAL_SECONDS=3600
POLL_WARM_INTERVAL_SECONDS=86400
# Cap on one scheduler tick. Never binds at 22 boards; it exists so a scheduler
# waking after an outage drains the backlog over several ticks instead of
# queueing the whole registry at once.
POLL_ENQUEUE_BATCH_LIMIT=500
# Per-board backoff for a board that is gone, as opposed to HTTP_MAX_RETRIES
# above, which handles one flaky response. 15 minutes doubling to a 24h ceiling,
# so a board that comes back is still noticed within a day.
POLL_BACKOFF_BASE_SECONDS=900
POLL_BACKOFF_MAX_SECONDS=86400

# ---------------------------------------------------------------------------
# Web (Next.js). NEXT_PUBLIC_* is exposed to the browser — nothing secret.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
